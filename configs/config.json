{
    "seed": 42,
    "deterministic": true,
    "dataset_name": "Diabetic Retinopathy 2015 Colored Resized",
    "num_classes": 5,
    "class_names": [
        "No_DR",
        "Mild",
        "Moderate",
        "Severe",
        "Proliferate_DR"
    ],
    "class_mapping": {
        "0": "No_DR",
        "1": "Mild",
        "2": "Moderate",
        "3": "Severe",
        "4": "Proliferate_DR"
    },
    "use_subset": true,
    "subset_size": 4000,
    "train_ratio": 0.7,
    "val_ratio": 0.15,
    "test_ratio": 0.15,
    "image_size": 224,
    "in_channels": 3,
    "model_architecture": "densenet121",
    "pretrained": true,
    "batch_size": 32,
    "num_workers": 2,
    "num_epochs": 15,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss_function": "WeightedCrossEntropyLoss",
    "optimizer": "AdamW",
    "scheduler": "CosineAnnealingLR",
    "early_stopping_patience": 4,
    "min_lr": 1e-06,
    "artifact_dir": "./artifacts",
    "model_save_path": "./artifacts/best_densenet121_dr.pth",
    "config_save_path": "./artifacts/config.json",
    "class_map_save_path": "./artifacts/class_mapping.json",
    "metrics_save_path": "./artifacts/evaluation_metrics.json"
}
